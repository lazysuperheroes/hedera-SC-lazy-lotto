# hardhat-toolbox 3.0.0 declares a peer of @typechain/ethers-v6 ^0.4 while
# @typechain/hardhat 9 (and this repo) use ^0.5, so plain `npm ci` stops with
# ERESOLVE. The lockfile has always been generated with legacy peer deps;
# this makes that the default here. npm never publishes .npmrc.
legacy-peer-deps=true
